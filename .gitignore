# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local financial data - never commit this
/data/
*.db
*.db-journal
*.db-wal
*.db-shm

# local dev tooling config (machine-specific paths)
/.claude/

# Electron packaging output — regenerated by electron:prepare / dist:* (see
# package.json and docs/packaging.md); build/icon.icns and build/icon.ico
# ARE committed (electron-builder reads them directly), only the
# intermediate icon artifacts and compiled/packaged output are ignored here.
/dist-electron/
/release/
/build/icon-1024.png
/build/icon.iconset/
